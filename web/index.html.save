<!DOCTYPE html>



<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AI Defense Lab — Payment Security</title>

  <link rel="icon"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 20'%3E%3Ccircle cx='11' cy='10' r='9' fill='%23ff4757'/%3E%3Ccircle cx='21' cy='10' r='9' fill='%2300c896'/%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>

  <style>
    :root {
      --bg: #f4f6fa;
      --surface: #ffffff;
      --surface2: #f8f9fc;

      --ink: #151827;
      --muted: #6c7287;
      --line: #e8ebf2;

      --red: #ff4757;
      --red-dark: #d71935;
      --red-soft: #ffe7eb;

      --teal: #00c896;
      --teal-dark: #00875f;
      --teal-soft: #dcf9ef;

      --blue: #3654ff;
      --blue-soft: #e9edff;

      --amber: #ffab00;
      --amber-soft: #fff3d6;

      --purple: #7c5cff;
      --purple-soft: #eeeaff;

      --dark: #171a2b;
      --dark2: #0d101c;

      --shadow-sm: 0 2px 8px rgba(20, 25, 45, .04);
      --shadow-md: 0 8px 25px rgba(20, 25, 45, .07);
      --shadow-lg: 0 20px 55px rgba(20, 25, 45, .12);

      --radius: 18px;
      --radius-sm: 12px;

      --sidebar: 245px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .mono {
      font-family: "JetBrains Mono", monospace;
    }

    .display {
      font-family: "Space Grotesk", sans-serif;
    }

    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: var(--sidebar);

      background: #111421;
      color: white;

      padding: 22px 14px;

      z-index: 1000;

      display: flex;
      flex-direction: column;

      border-right: 1px solid rgba(255, 255, 255, .05);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;

      padding: 8px 10px 28px;

      font-family: "Space Grotesk";
      font-size: 15px;
      font-weight: 800;
      letter-spacing: .4px;
    }

    .logo {
      position: relative;
      width: 32px;
      height: 22px;
    }

    .logo span {
      position: absolute;

      width: 19px;
      height: 19px;

      border-radius: 50%;

      top: 1px;
    }

    .logo .r {
      left: 0;
      background: var(--red);
    }

    .logo .t {
      left: 12px;
      background: var(--teal);
    }

    .sidebar-label {
      padding: 10px 12px 7px;

      font-family: "JetBrains Mono";
      font-size: 9px;

      color: #6f758c;

      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .nav {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 11px;

      padding: 11px 12px;

      color: #9298ae;

      border-radius: 10px;

      font-size: 12.5px;
      font-weight: 600;

      transition: .15s;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, .06);
      color: white;
    }

    .nav-item.active {
      background: rgba(0, 200, 150, .13);
      color: #69e5c1;
    }

    .nav-icon {
      width: 20px;
      text-align: center;
      font-size: 15px;
    }

    .sidebar-bottom {
      margin-top: auto;
    }

    .backend-mini {
      padding: 13px;

      border-radius: 12px;

      background: #191d2c;

      border: 1px solid rgba(255, 255, 255, .05);
    }

    .backend-mini-title {
      font-family: "JetBrains Mono";
      font-size: 9px;
      color: #70778f;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .backend-mini-status {
      display: flex;
      align-items: center;
      gap: 7px;

      font-size: 11px;
      font-weight: 700;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #73798c;
    }

    .status-dot.online {
      background: var(--teal);
      box-shadow: 0 0 0 4px rgba(0, 200, 150, .1);
    }

    .status-dot.offline {
      background: var(--red);
    }

    .version {
      font-family: "JetBrains Mono";
      font-size: 9px;
      color: #555c73;
      margin-top: 7px;
    }

    .mobile-top {
      display: none;

      position: fixed;
      top: 0;
      left: 0;
      right: 0;

      height: 60px;

      background: #111421;
      color: white;

      z-index: 1100;

      align-items: center;
      justify-content: space-between;

      padding: 0 16px;
    }

    .mobile-brand {
      font-family: "Space Grotesk";
      font-weight: 800;
      font-size: 14px;
    }

    .menu-btn {
      border: 0;
      background: #222638;
      color: white;

      width: 38px;
      height: 38px;

      border-radius: 9px;
    }

    .main {
      margin-left: var(--sidebar);
      min-height: 100vh;
    }

    .topbar {
      height: auto;
      min-height: 68px;

      background: rgba(255, 255, 255, .9);

      backdrop-filter: blur(12px);

      border-bottom: 1px solid var(--line);

      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;

      padding: 12px 30px;

      position: sticky;
      top: 0;
      z-index: 100;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;

      font-size: 12px;
      color: var(--muted);
    }

    .breadcrumb b {
      color: var(--ink);
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .api-pill {
      display: flex;
      align-items: center;
      gap: 7px;

      padding: 8px 12px;

      border-radius: 999px;

      background: var(--surface2);

      font-family: "JetBrains Mono";
      font-size: 10px;

      color: var(--muted);
    }

    .btn-small {
      border: 1px solid var(--line);

      background: white;

      padding: 8px 12px;

      border-radius: 9px;

      font-size: 11px;
      font-weight: 700;

      color: var(--ink);
    }

    .btn-small:hover {
      background: var(--surface2);
    }

    .page {
      max-width: 1400px;
      margin: auto;
      padding: 34px 30px 70px;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 28px;

      margin-bottom: 26px;
    }

    .hero-main {
      background: var(--surface);

      border-radius: 24px;

      padding: 38px;

      box-shadow: var(--shadow-sm);

      position: relative;
      overflow: hidden;
    }

    .hero-main:after {
      content: "";

      position: absolute;

      width: 300px;
      height: 300px;

      right: -130px;
      bottom: -150px;

      border-radius: 50%;

      background: var(--teal-soft);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      background: var(--teal-soft);
      color: var(--teal-dark);

      padding: 7px 12px;

      border-radius: 999px;

      font-family: "JetBrains Mono";
      font-size: 9.5px;
      font-weight: 700;

      letter-spacing: .6px;
      text-transform: uppercase;

      margin-bottom: 18px;
    }

    .hero-main h1 {
      font-family: "Space Grotesk";

      font-size: 45px;
      line-height: 1.05;

      letter-spacing: -1.5px;

      margin-bottom: 15px;

      max-width: 700px;
    }

    .hero-main h1 .red {
      color: var(--red);
    }

    .hero-main h1 .teal {
      color: var(--teal-dark);
    }

    .hero-description {
      color: var(--muted);

      font-size: 14px;

      max-width: 650px;

      line-height: 1.7;

      margin-bottom: 24px;
    }

    .hero-actions {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
    }

    .primary-btn {
      background: var(--dark);
      color: white;

      border: 0;

      padding: 12px 17px;

      border-radius: 999px;

      font-family: "Space Grotesk";
      font-size: 12px;
      font-weight: 700;

      box-shadow: var(--shadow-sm);
    }

    .primary-btn:hover {
      transform: translateY(-1px);
    }

    .secondary-btn {
      background: white;
      color: var(--ink);

      border: 1px solid var(--line);

      padding: 12px 17px;

      border-radius: 999px;

      font-family: "Space Grotesk";
      font-size: 12px;
      font-weight: 700;
    }

    .hero-visual {
      background: var(--dark);

      border-radius: 24px;

      min-height: 285px;

      position: relative;

      overflow: hidden;

      box-shadow: var(--shadow-md);

      display: flex;
      align-items: center;
      justify-content: center;
    }

    .venn {
      width: 230px;
      height: 230px;
      position: relative;
    }

    .vcircle {
      position: absolute;

      width: 145px;
      height: 145px;

      border-radius: 50%;

      top: 40px;
    }

    .vcircle.red {
      left: 10px;
      background: rgba(255, 71, 87, .9);
      box-shadow: 0 15px 40px rgba(255, 71, 87, .25);
    }

    .vcircle.teal {
      right: 10px;
      background: rgba(0, 200, 150, .9);
      box-shadow: 0 15px 40px rgba(0, 200, 150, .25);
    }

    .vlabel {
      position: absolute;

      font-family: "JetBrains Mono";

      font-size: 9px;
      font-weight: 700;

      letter-spacing: .5px;

      text-transform: uppercase;
    }

    .vlabel.red {
      top: 22px;
      left: 17px;
      color: #ff8e99;
    }

    .vlabel.teal {
      top: 22px;
      right: 17px;
      color: #69e5c1;
    }

    .vlabel.loop {
      bottom: 23px;
      left: 50%;
      transform: translateX(-50%);

      background: white;
      color: var(--dark);

      padding: 7px 13px;

      border-radius: 999px;

      white-space: nowrap;

      font-size: 9px;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 10px;

      margin-top: 23px;

      position: relative;
      z-index: 2;
    }

    .hero-stat {
      background: var(--surface2);

      border-radius: 12px;

      padding: 13px;
    }

    .hero-stat .value {
      font-family: "Space Grotesk";
      font-size: 21px;
      font-weight: 800;
    }

    .hero-stat .label {
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: .4px;
    }

    .section {
      margin-top: 30px;
      scroll-margin-top: 90px;
    }

    .section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;

      margin-bottom: 15px;

      gap: 20px;
    }

    .section-title {
      font-family: "Space Grotesk";

      font-size: 23px;
      font-weight: 800;

      letter-spacing: -.5px;
    }

    .section-sub {
      color: var(--muted);
      font-size: 11.5px;
      margin-top: 3px;
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 13px;
    }

    .kpi {
      background: var(--surface);

      border: 1px solid var(--line);

      border-radius: 16px;

      padding: 18px;

      box-shadow: var(--shadow-sm);

      position: relative;
      overflow: hidden;
    }

    .kpi:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .kpi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .kpi-icon {
      width: 32px;
      height: 32px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 9px;

      font-size: 14px;
    }

    .kpi-icon.teal {
      background: var(--teal-soft);
    }

    .kpi-icon.red {
      background: var(--red-soft);
    }

    .kpi-icon.blue {
      background: var(--blue-soft);
    }

    .kpi-icon.amber {
      background: var(--amber-soft);
    }

    .kpi .number {
      font-family: "Space Grotesk";
      font-size: 27px;
      font-weight: 800;

      margin-top: 11px;
    }

    .kpi .caption {
      color: var(--muted);

      font-size: 9.5px;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .kpi-change {
      font-family: "JetBrains Mono";
      font-size: 9px;
      color: var(--teal-dark);
    }

    .dashboard-grid {
      display: grid;

      grid-template-columns: 1.5fr .85fr;

      gap: 16px;

      margin-top: 16px;
    }

    .card {
      background: var(--surface);

      border: 1px solid var(--line);

      border-radius: 18px;

      padding: 21px;

      box-shadow: var(--shadow-sm);
    }

    .card-title {
      font-family: "Space Grotesk";

      font-size: 14px;
      font-weight: 800;
    }

    .card-caption {
      color: var(--muted);

      font-size: 10.5px;

      margin-top: 3px;
      margin-bottom: 15px;
    }

    .chart-wrap {
      height: 245px;
      position: relative;
    }

    .health-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .health-item {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 12px;

      border-radius: 11px;

      background: var(--surface2);
    }

    .health-left {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .health-icon {
      width: 30px;
      height: 30px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 8px;

      background: white;

      border: 1px solid var(--line);
    }

    .health-name {
      font-size: 11px;
      font-weight: 700;
    }

    .health-description {
      color: var(--muted);
      font-size: 9px;
    }

    .health-status {
      font-family: "JetBrains Mono";
      font-size: 8px;
      font-weight: 700;

      padding: 5px 7px;

      border-radius: 999px;

      background: var(--teal-soft);
      color: var(--teal-dark);
    }

    .health-status.off {
      background: var(--red-soft);
      color: var(--red-dark);
    }

    .pipeline {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .pipeline-step {
      background: var(--surface);

      border: 1px solid var(--line);

      border-radius: 15px;

      padding: 17px;

      box-shadow: var(--shadow-sm);
    }

    .step-number {
      width: 29px;
      height: 29px;

      border-radius: 8px;

      display: flex;
      align-items: center;
      justify-content: center;

      color: white;

      font-family: "Space Grotesk";
      font-size: 11px;
      font-weight: 800;

      margin-bottom: 11px;
    }

    .step-number.one {
      background: var(--teal);
    }

    .step-number.two {
      background: var(--blue);
    }

    .step-number.three {
      background: var(--red);
    }

    .step-number.four {
      background: var(--amber);
    }

    .pipeline-step h4 {
      font-family: "Space Grotesk";
      font-size: 13px;

      margin-bottom: 5px;
    }

    .pipeline-step p {
      color: var(--muted);
      font-size: 10.5px;
      line-height: 1.55;
    }

    .console-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .team-card {
      border-radius: 18px;

      padding: 22px;

      box-shadow: var(--shadow-sm);

      border: 1px solid var(--line);
    }

    .team-card.blue-team {
      background: linear-gradient(145deg, #fff, #f1fffa);
    }

    .team-card.red-team {
      background: linear-gradient(145deg, #fff, #fff3f5);
    }

    .team-header {
      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 17px;
    }

    .team-title {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .team-badge {
      padding: 5px 8px;

      border-radius: 7px;

      font-family: "JetBrains Mono";
      font-size: 8px;
      font-weight: 700;

      text-transform: uppercase;
    }

    .team-badge.blue {
      background: var(--teal-soft);
      color: var(--teal-dark);
    }

    .team-badge.red {
      background: var(--red-soft);
      color: var(--red-dark);
    }

    .team-title h3 {
      font-family: "Space Grotesk";
      font-size: 15px;
    }

    .live-label {
      font-family: "JetBrains Mono";
      font-size: 8px;
      color: var(--muted);
    }

    .field-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 11px;
    }

    label {
      display: block;

      font-size: 8.5px;

      font-weight: 700;

      color: var(--muted);

      text-transform: uppercase;

      letter-spacing: .5px;

      margin: 11px 0 5px;
    }

    input[type="number"],
    input[type="text"],
    select {
      width: 100%;

      border: 1px solid var(--line);

      background: white;

      color: var(--ink);

      padding: 10px 11px;

      border-radius: 9px;

      outline: none;

      font-family: "JetBrains Mono";

      font-size: 10px;

      transition: .15s;
    }

    input:focus,
    select:focus {
      border-color: var(--blue);

      box-shadow: 0 0 0 3px rgba(54, 84, 255, .08);
    }

    .action-btn {
      width: 100%;

      border: 0;

      padding: 12px;

      border-radius: 999px;

      margin-top: 16px;

      font-family: "Space Grotesk";

      font-size: 11px;

      font-weight: 800;

      transition: .15s;
    }

    .action-btn:hover {
      transform: translateY(-1px);
    }

    .action-btn.blue {
      background: var(--teal);
      color: #07352d;
    }

    .action-btn.red {
      background: var(--red);
      color: #40000a;
    }

    .result {
      margin-top: 14px;

      min-height: 72px;

      padding-top: 14px;

      border-top: 1px solid var(--line);
    }

    .hint {
      background: var(--surface2);

      border-radius: 9px;

      padding: 11px;

      color: var(--muted);

      font-size: 9.5px;

      line-height: 1.55;
    }

    .risk-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .risk-number {
      font-family: "Space Grotesk";

      font-size: 29px;

      font-weight: 800;
    }

    .risk-progress {
      flex: 1;

      height: 8px;

      background: #eceef4;

      border-radius: 999px;

      overflow: hidden;
    }

    .risk-fill {
      height: 100%;

      border-radius: 999px;

      transition: .5s;
    }

    .badge {
      display: inline-block;

      padding: 5px 9px;

      border-radius: 999px;

      font-family: "JetBrains Mono";

      font-size: 8px;

      font-weight: 700;

      text-transform: uppercase;

      margin-top: 9px;
    }

    .badge.fraud {
      background: var(--red-soft);
      color: var(--red-dark);
    }

    .badge.legit {
      background: var(--teal-soft);
      color: var(--teal-dark);
    }

    .narrative {
      color: var(--muted);

      font-size: 9.5px;

      line-height: 1.6;

      margin-top: 9px;
    }

    .spin {
      display: inline-block;

      width: 11px;
      height: 11px;

      border: 2px solid #dfe3ed;

      border-top-color: var(--blue);

      border-radius: 50%;

      animation: spin .7s linear infinite;

      margin-right: 6px;

      vertical-align: middle;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg)
      }
    }

    .slider-row {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    input[type="range"] {
      flex: 1;
      accent-color: var(--red);
    }

    .intensity {
      font-family: "JetBrains Mono";
      font-size: 10px;
      width: 36px;
    }

    .arsenal-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .attack-card {
      background: var(--surface);

      border: 1px solid var(--line);

      border-radius: 15px;

      padding: 17px;

      box-shadow: var(--shadow-sm);

      transition: .18s;
    }

    .attack-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .attack-index {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      width: 27px;
      height: 27px;

      border-radius: 8px;

      background: var(--red-soft);

      color: var(--red-dark);

      font-family: "JetBrains Mono";

      font-size: 8px;
      font-weight: 700;

      margin-bottom: 10px;
    }

    .attack-card h4 {
      font-family: "Space Grotesk";

      font-size: 12.5px;

      margin-bottom: 6px;
    }

    .attack-card p {
      color: var(--muted);

      font-size: 9.5px;

      line-height: 1.55;

      min-height: 60px;
    }

    .attack-bottom {
      margin-top: 12px;

      padding-top: 10px;

      border-top: 1px solid var(--line);

      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .attack-rate {
      font-family: "Space Grotesk";

      font-size: 14px;
      font-weight: 800;
    }

    .attack-rate.high {
      color: var(--red-dark);
    }

    .attack-rate.low {
      color: var(--teal-dark);
    }

    .mini-bar {
      width: 60px;
      height: 5px;

      background: #edf0f5;

      border-radius: 99px;

      overflow: hidden;
    }

    .mini-fill {
      height: 100%;

      border-radius: 99px;

      background: var(--red);
    }

    .loop-console {
      background: var(--dark);

      border-radius: 18px;

      overflow: hidden;

      box-shadow: var(--shadow-md);
    }

    .console-header {
      display: flex;
      align-items: center;
      gap: 8px;

      padding: 12px 17px;

      background: #0d101b;
    }

    .console-dots {
      display: flex;
      gap: 5px;
    }

    .console-dots span {
      width: 8px;
      height: 8px;

      border-radius: 50%;
    }

    .console-dots span:nth-child(1) {
      background: var(--red);
    }

    .console-dots span:nth-child(2) {
      background: var(--amber);
    }

    .console-dots span:nth-child(3) {
      background: var(--teal);
    }

    .console-title {
      font-family: "JetBrains Mono";
      color: #777d94;
      font-size: 9px;
      margin-left: 4px;
    }

    .console-body {
      min-height: 255px;
      max-height: 310px;

      overflow-y: auto;

      padding: 17px;

      font-family: "JetBrains Mono";

      font-size: 9.5px;

      line-height: 2;

      color: #d6d9e6;
    }

    .console-line {
      opacity: 0;
      animation: lineIn .25s ease forwards;
    }

    @keyframes lineIn {
      from {
        opacity: 0;
        transform: translateY(3px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .log-time {
      color: #555b73;
      margin-right: 6px;
    }

    .log-tag {
      display: inline-block;

      padding: 1px 6px;

      border-radius: 5px;

      font-size: 7px;

      font-weight: 700;

      margin-right: 7px;
    }

    .log-tag.sys {
      background: rgba(255, 255, 255, .07);
      color: #a6abc0;
    }

    .log-tag.gen {
      background: rgba(0, 200, 150, .14);
      color: #54ddba;
    }

    .log-tag.def {
      background: rgba(255, 171, 0, .13);
      color: #ffc44f;
    }

    .log-tag.atk {
      background: rgba(255, 71, 87, .15);
      color: #ff7986;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .metric-chart {
      height: 270px;
    }

    .api-console {
      background: #10131f;

      color: #dce0ef;

      border-radius: 16px;

      padding: 20px;

      font-family: "JetBrains Mono";

      font-size: 10px;

      line-height: 1.9;

      overflow: auto;
    }

    .api-line {
      color: #8f96ac;
    }

    .api-green {
      color: #5ee0bf;
    }

    .api-blue {
      color: #8292ff;
    }

    .api-yellow {
      color: #ffc857;
    }

    .quick-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .quick-card {
      background: var(--surface);

      border: 1px solid var(--line);

      border-radius: 15px;

      padding: 17px;

      cursor: pointer;

      transition: .15s;
    }

    .quick-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .quick-icon {
      width: 32px;
      height: 32px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 9px;

      background: var(--blue-soft);

      margin-bottom: 10px;
    }

    .quick-card h4 {
      font-family: "Space Grotesk";
      font-size: 12px;
    }

    .quick-card p {
      color: var(--muted);
      font-size: 9.5px;
      margin-top: 4px;
    }

    .footer {
      margin-top: 45px;

      border-top: 1px solid var(--line);

      padding-top: 20px;

      display: flex;

      justify-content: space-between;

      gap: 15px;

      flex-wrap: wrap;

      color: var(--muted);

      font-size: 9px;
    }

    .disclaimer {
      background: white;

      border: 1px solid var(--line);

      padding: 13px 15px;

      border-radius: 11px;

      margin-bottom: 15px;

      font-size: 9px;

      color: var(--muted);

      line-height: 1.6;
    }

    .disclaimer b {
      color: var(--ink);
    }

    .toast {
      position: fixed;

      right: 20px;
      bottom: 20px;

      background: var(--dark);

      color: white;

      padding: 11px 15px;

      border-radius: 10px;

      font-size: 10px;

      box-shadow: var(--shadow-lg);

      transform: translateY(20px);

      opacity: 0;

      pointer-events: none;

      transition: .25s;

      z-index: 2000;
    }

    .toast.show {
      opacity: 1;
      transform: none;
    }

    @media(max-width:1100px) {

      .sidebar {
        width: 210px;
      }

      .main {
        margin-left: 210px;
      }

      .hero {
        grid-template-columns: 1fr;
      }

      .hero-visual {
        min-height: 240px;
      }

      .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .arsenal-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .pipeline {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media(max-width:800px) {

      .sidebar {
        transform: translateX(-100%);
        transition: .25s;
      }

      .sidebar.open {
        transform: none;
      }

      .mobile-top {
        display: flex;
      }

      .main {
        margin-left: 0;
      }

      .topbar {
        display: none;
      }

      .page {
        padding: 80px 15px 50px;
      }

      .hero-main {
        padding: 25px;
      }

      .hero-main h1 {
        font-size: 35px;
      }

      .hero-stats {
        grid-template-columns: 1fr;
      }

      .dashboard-grid,
      .console-grid,
      .metrics-grid {
        grid-template-columns: 1fr;
      }

      .pipeline {
        grid-template-columns: 1fr;
      }

      .arsenal-grid {
        grid-template-columns: 1fr;
      }

      .field-grid {
        grid-template-columns: 1fr;
      }

      .quick-grid {
        grid-template-columns: 1fr;
      }

      .section-title {
        font-size: 20px;
      }
    }

    @media(max-width:500px) {

      .kpi-grid {
        grid-template-columns: 1fr;
      }

      .hero-main h1 {
        font-size: 31px;
      }

      .hero-main {
        padding: 21px;
      }

      .card,
      .team-card {
        padding: 16px;
      }
    }

    /* ===== THEME TOGGLE (clean) ===== */
    html[data-theme="dark"] {
      --bg: #0B0E17;
      --surface: #141926;
      --surface2: #1B2231;
      --ink: #F2F5FC;
      --muted: #8890A6;
      --line: #262E40;
    }

    html[data-theme="dark"] .topbar {
      background: rgba(15, 18, 28, .92);
      border-bottom-color: var(--line);
    }

    html[data-theme="dark"] input[type=number],
    html[data-theme="dark"] input[type=text],
    html[data-theme="dark"] select {
      background: var(--surface2);
      border-color: var(--line);
      color: var(--ink);
    }

    html[data-theme="dark"] .btn-small,
    html[data-theme="dark"] .secondary-btn {
      background: var(--surface);
      border-color: var(--line);
      color: var(--ink);
    }

    html[data-theme="dark"] .disclaimer {
      background: var(--surface);
      border-color: var(--line);
    }

    html[data-theme="dark"] .team-card.blue-team,
    html[data-theme="dark"] .team-card.red-team {
      background: linear-gradient(145deg, var(--surface), var(--surface2));
    }

    html[data-theme="dark"] .health-icon {
      background: var(--surface2);
      border-color: var(--line);
    }

    html[data-theme="dark"] .primary-btn {
      background: #F2F5FC;
      color: #0B0E17;
    }

    html[data-theme="dark"] ::-webkit-scrollbar-thumb {
      background: #333c52;
    }
  </style>

<style id="circle-clickable-css">
.vcircle,
.vlabel.loop {
  cursor: pointer;
}

.vcircle {
  border: 0;
  padding: 0;
}

.vcircle:hover {
  transform: scale(1.06);
  filter: brightness(1.15);
}

.vlabel.loop {
  border: 0;
  background: transparent;
  font: inherit;
  color: inherit;
  padding: 6px 12px;
}

.vlabel.loop:hover {
  opacity: 0.85;
}
</style>


<style id="live-demo-final-css">

/* ============================================================
   CLICKABLE RED / BLUE / CLOSED LOOP
   ============================================================ */

.vcircle,
.vlabel.loop {
  cursor: pointer !important;
  transition:
    transform .25s ease,
    filter .25s ease,
    opacity .25s ease,
    box-shadow .25s ease;
}

.vcircle:hover {
  transform: scale(1.08);
  filter: brightness(1.18);
}

.vlabel.loop:hover {
  transform: scale(1.08);
  opacity: 1;
}

.vcircle.live-active {
  animation: circlePulse 1.1s ease-in-out infinite;
}

@keyframes circlePulse {
  0%,100% {
    transform: scale(1);
    filter: brightness(1);
  }
  50% {
    transform: scale(1.10);
    filter: brightness(1.3);
  }
}

/* ============================================================
   LIVE DEMO MODAL
   ============================================================ */

#liveDemoModal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999999;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(5, 8, 18, .88);
  backdrop-filter: blur(12px);
}

#liveDemoModal.open {
  display: flex;
}

.live-demo-window {
  width: min(940px, 96vw);
  max-height: 90vh;
  overflow: hidden;
  border-radius: 24px;
  background: #0d1120;
  color: white;
  border: 1px solid rgba(255,255,255,.12);
  box-shadow:
    0 40px 120px rgba(0,0,0,.55),
    0 0 60px rgba(0,200,170,.08);
}

.live-demo-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid rgba(255,255,255,.09);
}

.live-demo-title {
  font-weight: 800;
  letter-spacing: .02em;
}

.live-demo-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #7ee7cf;
}

.live-demo-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #18c79d;
  box-shadow: 0 0 14px #18c79d;
}

.live-demo-close {
  border: 0;
  background: rgba(255,255,255,.08);
  color: white;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  cursor: pointer;
  font-size: 18px;
}

.live-demo-body {
  padding: 28px;
}

.live-demo-progress {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 7px;
  margin-bottom: 28px;
}

.live-demo-progress span {
  height: 5px;
  border-radius: 10px;
  background: rgba(255,255,255,.10);
  transition: background .3s ease;
}

.live-demo-progress span.active {
  background: #19c89d;
  box-shadow: 0 0 14px rgba(25,200,157,.45);
}

.live-demo-stage {
  min-height: 380px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.live-demo-kicker {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #7d8aa8;
  margin-bottom: 12px;
}

.live-demo-headline {
  font-size: clamp(28px, 5vw, 52px);
  line-height: 1.05;
  font-weight: 900;
  margin-bottom: 18px;
}

.live-demo-headline.red {
  color: #ff5366;
}

.live-demo-headline.teal {
  color: #18c79d;
}

.live-demo-headline.white {
  color: white;
}

.live-demo-sub {
  color: #aeb7cc;
  line-height: 1.7;
  max-width: 720px;
}

.live-txn-card {
  margin-top: 26px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.live-txn-cell {
  padding: 18px;
  border-radius: 14px;
  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.08);
}

.live-txn-cell small {
  display: block;
  color: #77829b;
  margin-bottom: 7px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.live-txn-cell strong {
  font-size: 19px;
}

.live-api-flow {
  margin-top: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

.live-api-node {
  padding: 13px 18px;
  border-radius: 12px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.10);
  font-weight: 700;
  font-size: 13px;
}

.live-api-arrow {
  color: #18c79d;
  font-size: 20px;
}

.live-risk {
  margin-top: 26px;
}

.live-risk-number {
  font-size: 70px;
  line-height: 1;
  font-weight: 900;
}

.live-risk-label {
  color: #8994ab;
  font-size: 12px;
  margin-top: 6px;
  text-transform: uppercase;
  letter-spacing: .1em;
}

.live-risk-track {
  height: 13px;
  background: rgba(255,255,255,.08);
  border-radius: 20px;
  overflow: hidden;
  margin-top: 18px;
}

.live-risk-fill {
  width: 0%;
  height: 100%;
  border-radius: inherit;
  transition: width .8s ease;
}

.live-result {
  margin-top: 26px;
  padding: 22px;
  border-radius: 16px;
  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.08);
}

.live-result-big {
  font-size: 30px;
  font-weight: 900;
}

.live-bars {
  margin-top: 26px;
}

.live-bar-row {
  display: grid;
  grid-template-columns: 80px 1fr 80px;
  gap: 12px;
  align-items: center;
  margin: 15px 0;
}

.live-bar-track {
  height: 14px;
  border-radius: 20px;
  background: rgba(255,255,255,.08);
  overflow: hidden;
}

.live-bar-fill {
  height: 100%;
  width: 0%;
  border-radius: inherit;
  transition: width 1.2s ease;
}

.live-bar-before {
  background: #ff5366;
}

.live-bar-after {
  background: #18c79d;
}

.live-demo-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 25px;
}

.live-demo-button {
  border: 0;
  border-radius: 12px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 800;
}

.live-demo-button.primary {
  background: #18c79d;
  color: #06120f;
}

.live-demo-button.secondary {
  background: rgba(255,255,255,.08);
  color: white;
}

.live-error {
  color: #ff7180;
  padding: 16px;
  border-radius: 12px;
  background: rgba(255,80,100,.08);
  border: 1px solid rgba(255,80,100,.18);
}

@media(max-width:700px) {
  .live-txn-card {
    grid-template-columns: 1fr 1fr;
  }

  .live-demo-body {
    padding: 20px;
  }

  .live-demo-stage {
    min-height: 330px;
  }

  .live-demo-progress {
    grid-template-columns: repeat(3, 1fr);
  }
}

</style>

</head>

<body>

  <div class="mobile-top">
    <div class="mobile-brand">
      ◉ AI DEFENSE LAB
    </div>

    <button class="menu-btn" id="menuBtn">
      ☰
    </button>
  </div>

  <aside class="sidebar" id="sidebar">

    <div class="brand">

      <div class="logo">
        <span class="r"></span>
        <span class="t"></span>
      </div>

      AI DEFENSE LAB

    </div>

    <div class="sidebar-label">
      Console
    </div>

    <nav class="nav">

      <a class="nav-item active" href="#overview">
        <span class="nav-icon">⌂</span>
        Overview
      </a>

      <a class="nav-item" href="#fraud">
        <span class="nav-icon">◉</span>
        Fraud Detection
      </a>

      <a class="nav-item" href="#attack">
        <span class="nav-icon">ϟ</span>
        Attack Simulator
      </a>

      <a class="nav-item" href="#arsenal">
        <span class="nav-icon">◇</span>
        Red Team Arsenal
      </a>

      <a class="nav-item" href="#metrics">
        <span class="nav-icon">▥</span>
        Metrics
      </a>

      <a class="nav-item" href="#api">
        <span class="nav-icon">⌘</span>
        API Console
      </a>

    </nav>

    <div class="sidebar-label">
      System
    </div>

    <nav class="nav">
      <a class="nav-item" href="#pipeline">
        <span class="nav-icon">↻</span>
        Closed Loop
      </a>
    </nav>

    <div class="sidebar-bottom">

      <div class="backend-mini">

        <div class="backend-mini-title">
          Backend connection
        </div>

        <div class="backend-mini-status">
          <span class="status-dot" id="sideDot"></span>
          <span id="sideStatus">
            Checking API...
          </span>
        </div>

        <div class="version">
          FastAPI · :8000
        </div>

      </div>

    </div>

  </aside>

  <main class="main">

    <div class="topbar">

      <div class="breadcrumb">
        AI Defense Lab
        <span>/</span>
        <b>Defense Command Center</b>
      </div>

      <div class="top-actions">

        <button class="btn-small" id="themeToggle" onclick="toggleTheme()">🌙 Dark</button>

        <div class="api-pill">
          <span class="status-dot" id="topDot"></span>
          <span id="topStatus">API checking</span>
        </div>

        <button class="btn-small" onclick="refreshHealth()">
          ↻ Refresh
        </button>

        <button class="btn-small" onclick="scrollToDemo()">
          + New Analysis
        </button>

      </div>

    </div>

    <div class="page">

      <section class="hero" id="overview">

        <div class="hero-main">

          <div class="eyebrow">
            MASTERCARD AI DEFENSE LAB · RED / BLUE TEAM
          </div>

          <h1>
            Build the
            <span class="red">attack</span>.
            <br>
            Build the
            <span class="teal">defense</span>.
          </h1>

          <p class="hero-description">
            A closed-loop Red-Team / Blue-Team payment security system
            that generates synthetic fraud, simulates adversarial attacks,
            detects suspicious transactions and learns from what it missed.
          </p>

          <div class="hero-actions">

            <button class="primary-btn" onclick="scrollToDemo()">
              Try Live Defense Console →
            </button>

            <button class="secondary-btn" onclick="document.getElementById('arsenal').scrollIntoView()">
              View Attack Arsenal
            </button>

          </div>

          <div class="hero-stats">

            <div class="hero-stat">
              <div class="value">0.972</div>
              <div class="label">Test ROC-AUC</div>
            </div>

            <div class="hero-stat">
              <div class="value">7</div>
              <div class="label">Attack Families</div>
            </div>

            <div class="hero-stat">
              <div class="value">14.7 → 79.6%</div>
              <div class="label">Detection After Retrain</div>
            </div>

          </div>

        </div>

        <div class="hero-visual">
          <div class="venn">

            <div class="vlabel red">
              Red Team
            </div>

            <div class="vlabel teal">
              Blue Team
            </div>

            <button class="vcircle red" type="button" aria-label="Red Team" onclick="document.getElementById('attack')?.scrollIntoView({behavior:'smooth'})"></button>
            <button class="vcircle teal" type="button" aria-label="Blue Team" onclick="document.getElementById('fraud')?.scrollIntoView({behavior:'smooth'})"></button>

            <button class="vlabel loop" type="button" aria-label="Closed Loop"
              onclick="document.getElementById('pipeline')?.scrollIntoView({behavior:'smooth'})">
              CLOSED LOOP
            </button>

          </div>
        </div>

      </section>

      <section class="section">

        <div class="section-head">
          <div>
            <div class="section-title">
              Defense Command Center
            </div>

            <div class="section-sub">
              Payment fraud detection, adversarial testing and model resilience.
            </div>
          </div>
        </div>

        <div class="kpi-grid">

          <div class="kpi">
            <div class="kpi-top">
              <div class="kpi-icon teal">
                ✓
              </div>

              <div class="kpi-change">
                TEST
              </div>
            </div>

            <div class="number">
              96.99%
            </div>

            <div class="caption">
              Test Accuracy
            </div>
          </div>

          <div class="kpi">
            <div class="kpi-top">
              <div class="kpi-icon red">
                !
              </div>

              <div class="kpi-change">
                FRAUD
              </div>
            </div>

            <div class="number">
              66.2%
            </div>

            <div class="caption">
              Fraud Recall
            </div>
