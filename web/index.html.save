            <select id="a_type">
              <option value="account_takeover">
                account_takeover
              </option>

              <option value="velocity_attack">
                velocity_attack
              </option>

              <option value="amount_manipulation">
                amount_manipulation
              </option>

              <option value="merchant_switching">
                merchant_switching
              </option>

              <option value="geo_evasion" selected>
                geo_evasion
              </option>

              <option value="low_and_slow">
