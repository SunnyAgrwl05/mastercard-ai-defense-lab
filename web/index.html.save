            <div class="slider-row">
              <input type="range" id="a_intensity" min="0" max="100" value="65">
              <span class="intensity" id="a_intensity_val">
                0.65
              </span>
            </div>

            <div class="hint" style="margin-top:13px">
              Attack begins from a clean synthetic ₹1,200 grocery transaction and modifies its behavior according to the
              selected attack family.
            </div>

            <button class="action-btn red" id="attackBtn">
              Craft & Detect Attack
            </button>

            <div class="result" id="attackResult">
              <div class="hint">
                Select an attack family, tune intensity and launch the adversarial simulation.
              </div>
            </div>

          </div>

        </div>

