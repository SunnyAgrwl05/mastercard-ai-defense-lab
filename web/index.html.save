        <div class="pipeline">

          <div class="pipeline-step">
            <div class="step-number one">
              01
            </div>

            <h4>
              Synthetic Transactions
            </h4>

            <p>
              120k labeled payment events with 1.2% synthetic fraud prevalence.
            </p>
          </div>

          <div class="pipeline-step">
            <div class="step-number two">
              02
            </div>

            <h4>
              Blue-Team Detector
            </h4>

            <p>
              XGBoost, Random Forest and Isolation Forest models compete for best validation performance.
            </p>
          </div>

          <div class="pipeline-step">
            <div class="step-number three">
              03
            </div>

            <h4>
              Red-Team Simulator
            </h4>

