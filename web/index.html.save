      <footer class="footer">

        <div class="disclaimer">
          <b>Synthetic data notice.</b>
          All transactions, customers and attack traces shown in this prototype
          are synthetically generated for research/demo purposes.
          No real Mastercard cardholder information or production fraud signals
          are used or claimed anywhere in this project.
          Risk thresholds are configurable demonstration thresholds and are not
          Mastercard production thresholds.
        </div>

        <div style="width:100%;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap">
          <span>
            AI Defense Lab — Payment Security
          </span>

          <span class="mono">
            FastAPI · XGBoost · scikit-learn · SHAP
          </span>
        </div>

      </footer>

    </div>

  </main>

  <div class="toast" id="toast"></div>

  <script>
    const API_BASE = "http://localhost:8000";

    const menuBtn = document.getElementById("menuBtn");
    const sidebar = document.getElementById("sidebar");

    menuBtn.addEventListener("click", () => {
      sidebar.classList.toggle("open");
    });

    document.querySelectorAll(".nav-item").forEach(item => {

      item.addEventListener("click", () => {

        document
          .querySelectorAll(".nav-item")
          .forEach(x => x.classList.remove("active"));

        item.classList.add("active");

        sidebar.classList.remove("open");

      });

    });

    let toastTimer;

    function showToast(message) {

      const toast = document.getElementById("toast");

      toast.textContent = message;

      toast.classList.add("show");

      clearTimeout(toastTimer);

      toastTimer = setTimeout(() => {
        toast.classList.remove("show");
      }, 2600);

    }

    function scrollToDemo() {

      document
        .getElementById("fraud")
        .scrollIntoView({
          behavior: "smooth"
        });

    }

    async function refreshHealth() {

      const sideDot =
        document.getElementById("sideDot");

      const topDot =
        document.getElementById("topDot");

      const sideStatus =
        document.getElementById("sideStatus");

      const topStatus =
        document.getElementById("topStatus");

      const healthFastAPI =
        document.getElementById("healthFastAPI");

      const apiConsoleStatus =
        document.getElementById("apiConsoleStatus");

      try {

        const response = await fetch(
          API_BASE + "/health",
          {
            method: "GET",
            signal: AbortSignal.timeout(3000)
          }
        );

        if (!response.ok) {
          throw new Error("Backend error");
        }

        const data = await response.json();

        const online =
          data.status === "ok";

        if (!online) {
          throw new Error("Backend not ready");
        }

        sideDot.className =
          "status-dot online";

        topDot.className =
          "status-dot online";

        sideStatus.textContent =
          "API online";

        topStatus.textContent =
          "API online";

        healthFastAPI.textContent =
          "ONLINE";

        healthFastAPI.classList.remove("off");

        apiConsoleStatus.textContent =
          "ONLINE";

        document
          .getElementById("healthModel")
          .textContent = "READY";

      }
      catch (error) {

        sideDot.className =
          "status-dot offline";

        topDot.className =
          "status-dot offline";

        sideStatus.textContent =
          "API offline";

        topStatus.textContent =
          "API offline";

        healthFastAPI.textContent =
          "OFFLINE";

        healthFastAPI.classList.add("off");

        apiConsoleStatus.textContent =
          "OFFLINE";

        document
          .getElementById("healthModel")
          .textContent = "UNAVAILABLE";

        document
          .getElementById("healthModel")
          .classList.add("off");

      }

    }

    refreshHealth();
    setInterval(refreshHealth, 15000);

    if (typeof Chart !== "undefined") {

      Chart.defaults.font.family =
        "Inter";

      Chart.defaults.color =
        "#6c7287";

      Chart.defaults.borderColor =
        "#e8ebf2";

    }

    function createActivityChart() {

      if (typeof Chart === "undefined")
        return;

      const canvas =
        document.getElementById("activityChart");

      if (!canvas)
        return;

      new Chart(canvas, {

        type: "line",

        data: {

          labels: [
            "1h", "2h", "3h", "4h",
            "5h", "6h", "7h", "8h",
            "9h", "10h", "11h", "12h"
          ],

          datasets: [

            {
              label: "Threat events",

              data: [
                8, 13, 10, 19,
                15, 25, 18, 31,
                24, 38, 29, 43
              ],

              borderColor: "#ff4757",
              backgroundColor: "rgba(255,71,87,.08)",
              fill: true,
              tension: .35,
              pointRadius: 2,
              borderWidth: 2
            },

            {
              label: "Detected",

              data: [
                6, 11, 9, 17,
                12, 21, 16, 27,
                21, 33, 26, 37
              ],

              borderColor: "#00c896",
              backgroundColor: "transparent",
              tension: .35,
              pointRadius: 2,
              borderWidth: 2
            }

          ]

        },

        options: {

          responsive: true,
          maintainAspectRatio: false,

          plugins: {
            legend: {
              labels: {
                boxWidth: 8,
                font: {
                  size: 9
                }
              }
            }
          },

          scales: {

            y: {
              beginAtZero: true,
              grid: {
                color: "#edf0f5"
              }
            },

            x: {
              grid: {
                display: false
              }
            }

          }

        }

      });

    }

    const attackData = [

      {
        n: "01",
        name: "Amount Manipulation",
        mech: "Keeps transaction amounts just below common threshold bands to avoid amount-based alerting.",
        evasion: 83.4
      },

      {
        n: "02",
        name: "Velocity Attack",
        mech: "Creates rapid transaction bursts across merchants and devices to exploit velocity detection gaps.",
        evasion: 80.3
      },

      {
        n: "03",
        name: "Merchant Switching",
        mech: "Spreads suspicious spending across multiple merchant categories so no single signal spikes.",
        evasion: 88.3
      },

      {
        n: "04",
        name: "Geographic Evasion",
        mech: "Keeps transaction location within a plausible commute radius instead of an obvious geographic jump.",
        evasion: 98.7
      },

      {
        n: "05",
        name: "Account Takeover",
        mech: "Combines sudden device, location, amount and velocity changes to imitate an ATO fingerprint.",
        evasion: 18.9
      },

      {
        n: "06",
        name: "Low-and-Slow Fraud",
        mech: "Uses many small transactions that remain below the victim's usual spending pattern.",
        evasion: 99.4
      },

      {
        n: "07",
        name: "Behavioral Mimicry",
        mech: "Crafts transactions to resemble the victim's historical spending behavior.",
        evasion: 99.6
      }

    ];

    function renderArsenal() {

      const grid =
        document.getElementById("arsenalGrid");

      if (!grid)
        return;

      grid.innerHTML = "";

      attackData.forEach(a => {

        const card =
          document.createElement("div");

        card.className =
          "attack-card";

        const rateClass =
          a.evasion > 60
            ? "high"
            : "low";

        card.innerHTML = `
        <span class="attack-index">
          ${a.n}
        </span>

        <h4>
          ${a.name}
        </h4>

        <p>
          ${a.mech}
        </p>

        <div class="attack-bottom">

          <div>
            <div style="font-size:8px;color:#6c7287">
              EVASION RATE
            </div>

            <div class="attack-rate ${rateClass}">
              ${a.evasion}%
            </div>
          </div>

          <div class="mini-bar">
            <div
              class="mini-fill"
              style="width:${a.evasion}%"
            ></div>
          </div>

        </div>
      `;

        grid.appendChild(card);

      });

    }

    function createMetricCharts() {

      if (typeof Chart === "undefined")
        return;

      new Chart(
        document.getElementById("attackChart"),
        {

          type: "bar",

          data: {

            labels: [
              "Behavioral Mimicry",
              "Low & Slow",
              "Geo Evasion",
              "Merchant Switching",
              "Amount Manipulation",
              "Velocity Attack",
              "Account Takeover"
            ],

            datasets: [{

              data: [
                0.4,
                0.6,
                1.3,
                11.7,
                16.6,
                19.7,
                81.1
              ],

              backgroundColor: [
                "#ff4757",
                "#ff4757",
                "#ff4757",
                "#ff4757",
                "#ff4757",
                "#ff4757",
                "#00c896"
              ],

              borderRadius: 6

            }]

          },

          options: {

            indexAxis: "y",

            responsive: true,
            maintainAspectRatio: false,

            plugins: {
              legend: {
                display: false
              }
            },

            scales: {

              x: {

                max: 100,

                ticks: {
                  callback: v => v + "%"
                },

                grid: {
                  color: "#edf0f5"
                }

              },

              y: {

                grid: {
                  display: false
                },

                ticks: {
                  font: {
                    size: 9
                  }
                }

              }

            }

          }

        }

      );

      new Chart(
        document.getElementById("loopChart"),
        {

          type: "bar",

          data: {

            labels: [
              "Before Retrain",
              "After Retrain"
            ],

            datasets: [{

              data: [
                14.7,
                79.6
              ],

              backgroundColor: [
                "#ff4757",
                "#00c896"
              ],

              borderRadius: 8

            }]

          },

          options: {

            responsive: true,
            maintainAspectRatio: false,

            plugins: {
              legend: {
                display: false
              }
            },

            scales: {

              y: {

                max: 100,

                ticks: {
                  callback: v => v + "%"
                },

                grid: {
                  color: "#edf0f5"
                }

              },

              x: {
                grid: {
                  display: false
                }
              }

            }

          }

        }

      );

      const rocPts = [
        [0, 0],
        [.01, .35],
        [.03, .55],
        [.06, .68],
        [.10, .78],
        [.18, .86],
        [.30, .91],
        [.50, .95],
        [.75, .98],
        [1, 1]
      ];

      new Chart(
        document.getElementById("rocChart"),
        {

          type: "line",

          data: {

            labels:
              rocPts.map(p => p[0]),

            datasets: [

              {
                label: "XGBoost AUC 0.972",

                data:
                  rocPts.map(p => p[1]),

                borderColor: "#00c896",

                backgroundColor:
                  "rgba(0,200,150,.08)",

                fill: true,
                tension: .3,
                pointRadius: 0,
                borderWidth: 2.5
              },

              {
                label: "Random Guess",

                data:
                  rocPts.map(p => p[0]),

                borderColor: "#c7cad6",
                borderDash: [4, 4],
                pointRadius: 0
              }

            ]

          },

          options: {

            responsive: true,
            maintainAspectRatio: false,

            plugins: {
              legend: {
                labels: {
                  boxWidth: 8,
                  font: {
                    size: 8
                  }
                }
              }
            },

            scales: {

              x: {
                title: {
                  display: true,
                  text: "FPR"
                }
              },

              y: {
                title: {
                  display: true,
                  text: "TPR"
                }
              }

            }

          }

        }

      );

      new Chart(
        document.getElementById("fiChart"),
        {

          type: "bar",

          data: {

            labels: [
              "Crypto exchange",
              "Merchant risk",
              "Customer risk appetite",
              "Failed txns",
              "Amount / baseline",
              "Txn frequency"
            ],

            datasets: [{

              data: [
                14.2,
                11.6,
                9.3,
                7.7,
                6.1,
                6.0
              ],

              backgroundColor: "#3654ff",
              borderRadius: 6

            }]

          },

          options: {

            indexAxis: "y",

            responsive: true,
            maintainAspectRatio: false,

            plugins: {
              legend: {
                display: false
              }
            },

            scales: {

              x: {
                ticks: {
                  callback: v => v + "%"
                }
              },

              y: {

                grid: {
                  display: false
                },

                ticks: {
                  font: {
                    size: 8
                  }
                }

              }

            }

          }

        }

      );

    }

    const logScript = [

      {
        tag: "sys",
        t: "00.00s",
        text: "closed-loop cycle started · seed=42"
      },

      {
        tag: "gen",
        t: "00.41s",
        text: "generated 120,000 synthetic transactions · fraud rate 1.20%"
      },

      {
        tag: "def",
        t: "04.10s",
        text: "trained xgboost blue-team detector · val PR-AUC 0.339"
      },

      {
        tag: "def",
        t: "04.30s",
        text: "test set: ROC-AUC 0.972 · recall 66.2% · precision 24.8%"
      },

      {
        tag: "atk",
        t: "05.02s",
        text: "red-team round 1 → generated 3,000 attacks across 7 families"
      },

      {
        tag: "atk",
        t: "05.55s",
        text: "scored round 1 → detection rate 14.7% on fresh attacks"
      },

      {
        tag: "atk",
        t: "05.61s",
        text: "adapting strategy weights → up-weighting behavioral_mimicry, low_and_slow"
      },

      {
        tag: "atk",
        t: "06.20s",
        text: "red-team round 2 → generated 3,000 adapted attacks"
      },

      {
        tag: "sys",
        t: "06.90s",
        text: "collected 5,046 missed attacks → adversarial training set"
      },

      {
        tag: "def",
        t: "11.40s",
        text: "retraining blue-team detector on augmented data..."
      },

      {
        tag: "atk",
        t: "12.10s",
        text: "round 3 → fresh unseen attacks scored before vs after retrain"
      },

      {
        tag: "def",
        t: "12.35s",
        text: "detection rate after retrain: 79.6% (+541% relative)"
      },

      {
        tag: "sys",
        t: "12.40s",
        text: "cycle complete — models + metrics saved to outputs/"
      }

    ];

    let consoleTimer = null;

    function playConsole() {

      const body =
        document.getElementById("consoleBody");

      body.innerHTML = "";

      if (consoleTimer)
        clearTimeout(consoleTimer);

      let index = 0;

      function next() {

        if (index >= logScript.length)
          return;

        const line =
          logScript[index];

        const div =
          document.createElement("div");

        div.className =
          "console-line";

        div.innerHTML = `
        <span class="log-time">
          [${line.t}]
        </span>

        <span class="log-tag ${line.tag}">
          ${line.tag}
        </span>

        ${line.text}
      `;

        body.appendChild(div);

        body.scrollTop =
          body.scrollHeight;

        index++;

        consoleTimer =
          setTimeout(next, 420);

      }

      next();

    }

    document
      .getElementById("a_intensity")
      .addEventListener("input", e => {

        document
          .getElementById("a_intensity_val")
          .textContent =
          (
            Number(e.target.value) / 100
          ).toFixed(2);

      });

    function riskColor(score) {

      if (score <= 30)
        return "#00c896";

      if (score <= 60)
        return "#ffab00";

      if (score <= 80)
        return "#ff7b47";

      return "#ff4757";

    }

    document
      .getElementById("scoreBtn")
      .addEventListener("click", async () => {

        const box =
          document.getElementById("scoreResult");

        box.innerHTML = `
        <div class="hint">
          <span class="spin"></span>
          Blue-Team detector scoring transaction...
        </div>
      `;

        const amount =
          parseFloat(
            document.getElementById("p_amount").value
          );

        const baseline =
          parseFloat(
            document.getElementById("p_baseline").value
          );

        if (
          !Number.isFinite(amount) ||
          !Number.isFinite(baseline)
        ) {

          box.innerHTML = `
         <div class="hint">
           Please enter valid amount and baseline values.
         </div>
       `;

          return;

        }

        const payload = {

          transaction_id:
            "TXN_DEMO_" + Date.now(),

          customer_id:
            "CUST_DEMO",

          amount,

          hour_of_day:
            parseInt(
              document.getElementById("p_hour").value
            ),

          merchant_category:
            document.getElementById("p_merchant").value,

          merchant_risk_score:
            0.6,

          payment_method:
            "online_card_not_present",

          device_type:
            document.getElementById("p_device").value,

          account_age_days:
            120,

          customer_baseline_spend:
            baseline,

          geo_distance_from_home_km:
            parseFloat(
              document.getElementById("p_geo").value
            ),

          txn_frequency_24h:
            parseInt(
              document.getElementById("p_freq").value
            ),

          failed_txn_count_24h:
            parseInt(
              document.getElementById("p_failed").value
            ),

          prev_txn_amount:
            baseline * .9,

          customer_risk_appetite:
            .5

        };

        try {

          const response =
            await fetch(
              API_BASE + "/predict",
              {

                method: "POST",

                headers: {
                  "Content-Type":
                    "application/json"
                },

                body:
                  JSON.stringify(payload),

                signal:
                  AbortSignal.timeout(7000)

              }

            );

          if (!response.ok) {

            throw new Error(
              "API error " +
              response.status
            );

          }

          const data =
            await response.json();

          const score =
            Number(data.risk_score) || 0;

          const color =
            riskColor(score);

          box.innerHTML = `
          <div class="risk-row">

            <div
              class="risk-number"
              style="color:${color}"
            >
              ${score.toFixed(1)}
            </div>

            <div class="risk-progress">
              <div
                class="risk-fill"
                style="
                  width:${Math.min(score, 100)}%;
                  background:${color};
                "
              ></div>
            </div>

          </div>

          <span class="badge ${data.prediction === "fraud"
              ? "fraud"
              : "legit"
            }">
            ${data.prediction || "unknown"
            }
          </span>

          <span
            class="badge"
            style="
              background:#f3f5f9;
              color:#687087;
              margin-left:5px;
            "
          >
            ${data.risk_bucket || "risk"
            }
          </span>

          <div class="narrative">
            ${data.narrative ||
            "Detector returned a score without an explanation."
            }
          </div>
        `;

          showToast(
            "Blue-Team analysis completed"
          );

        }
        catch (error) {

          box.innerHTML = `
          <div class="hint">
            <b>Backend unavailable.</b><br><br>
            Could not reach
            <span class="mono">
              ${API_BASE}
            </span>.
            <br><br>
            Start your backend with:
            <br>
            <span class="mono">
              uvicorn api.main:app --reload
            </span>
          </div>
        `;

          showToast(
            "Backend connection failed"
          );

        }

      });

    document
      .getElementById("attackBtn")
      .addEventListener("click", async () => {

        const box =
          document.getElementById("attackResult");

        box.innerHTML = `
        <div class="hint">
          <span class="spin"></span>
          Red-Team attack being crafted...
        </div>
      `;

        const intensity =
          parseFloat(
            document.getElementById("a_intensity").value
          ) / 100;

        const payload = {

          transaction: {

            transaction_id:
              "TXN_BASE_" + Date.now(),

            customer_id:
              "CUST_BASE",

            amount:
              1200,

            hour_of_day:
              14,

            merchant_category:
              "grocery",

            merchant_risk_score:
              .05,

            payment_method:
              "chip",

            device_type:
              "pos_terminal",

            account_age_days:
              900,

            customer_baseline_spend:
              1100,

            geo_distance_from_home_km:
              3,

            txn_frequency_24h:
              1,

            failed_txn_count_24h:
              0,

            prev_txn_amount:
              1050,

            customer_risk_appetite:
              .1

          },

          attack_type:
            document.getElementById("a_type").value,

          intensity

        };

        try {

          const response =
            await fetch(
              API_BASE + "/simulate-attack",
              {

                method: "POST",

                headers: {
                  "Content-Type":
                    "application/json"
                },

                body:
                  JSON.stringify(payload),

                signal:
                  AbortSignal.timeout(7000)

              }

            );

          if (!response.ok) {

            throw new Error(
              "API error " +
              response.status
            );

          }

          const data =
            await response.json();

          const detector =
            data.detector_result || {};

          const score =
            Number(detector.risk_score) || 0;

          const color =
            riskColor(score);

          const success =
            Boolean(data.attack_success);

          const modified =
            data.modified_transaction || {};

          box.innerHTML = `
          <div class="risk-row">

            <div
              class="risk-number"
              style="color:${color}"
            >
              ${score.toFixed(1)}
            </div>

            <div class="risk-progress">
              <div
                class="risk-fill"
                style="
                  width:${Math.min(score, 100)}%;
                  background:${color};
                "
              ></div>
            </div>

          </div>

          <span class="badge ${success
              ? "fraud"
              : "legit"
            }">
            ${success
              ? "ATTACK EVADED DETECTOR"
              : "ATTACK CAUGHT"
            }
          </span>

          <div class="narrative">
            Baseline ₹1,200 grocery transaction
            →
            <b>
              ${data.attack_type ||
            payload.attack_type
            }
            </b>
            · intensity
            ${Number(
              data.attack_intensity ??
              intensity
            ).toFixed(2)
            }
            <br>
            Modified amount:
            ₹${Math.round(
              Number(
                modified.amount ?? 1200
              )
            )}
            · frequency:
            ${modified.txn_frequency_24h ??
            "—"
            }
            · geo:
            ${Math.round(
              Number(
                modified.geo_distance_from_home_km ?? 0
              )
            )
            }km
            <br><br>
            ${detector.narrative ||
            "Attack simulation completed."
            }
          </div>
        `;

          showToast(
            success
              ? "Attack evaded detector"
              : "Attack caught by detector"
          );

        }
        catch (error) {

          box.innerHTML = `
          <div class="hint">
            <b>Backend unavailable.</b><br><br>
            Start:
            <br>
            <span class="mono">
              uvicorn api.main:app --reload
            </span>
          </div>
        `;

          showToast(
            "Attack API connection failed"
          );

        }

      });

    document
      .getElementById("replayBtn")
      .addEventListener(
        "click",
        playConsole
      );

    renderArsenal();
    createActivityChart();
    createMetricCharts();
    playConsole();

    const sections = [
      "overview",
      "fraud",
      "attack",
      "arsenal",
      "metrics",
      "api"
    ];

    window.addEventListener(
      "scroll",
      () => {

        let current = "";

        sections.forEach(id => {

          const section =
            document.getElementById(id);

          if (!section)
            return;

          const top =
            section.getBoundingClientRect().top;

          if (top < 150)
            current = id;

        });

        if (current) {

          document
            .querySelectorAll(".nav-item")
            .forEach(item => {

              item.classList.remove(
                "active"
              );

              if (
                item.getAttribute("href") ===
                "#" + current
              ) {

                item.classList.add(
                  "active"
                );

              }

            });

        }

      }
    );

    /* ===== THEME TOGGLE (working version) ===== */
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('defenseLabTheme', theme);
      const btn = document.getElementById('themeToggle');
      if (btn) btn.textContent = theme === 'dark' ? '☀️ Light' : '🌙 Dark';
    }
    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    }
    (function () {
      const saved = localStorage.getItem('defenseLabTheme');
      if (saved) { applyTheme(saved); }
      else {
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        applyTheme(prefersDark ? 'dark' : 'light');
      }
    })();

  </script>


<div id="liveDemoModal">
  <div class="live-demo-window">

    <div class="live-demo-top">
      <div>
        <div class="live-demo-title">
          AI DEFENSE LAB · LIVE DEFENSE LOOP
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:12px;">
        <div class="live-demo-status">
          <span class="live-demo-status-dot"></span>
          BACKEND CONNECTED
        </div>

        <button class="live-demo-close" id="liveDemoClose">
          ×
        </button>
      </div>
    </div>

    <div class="live-demo-body">

      <div class="live-demo-progress">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div id="liveDemoStage" class="live-demo-stage"></div>

      <div class="live-demo-footer">
        <button
          class="live-demo-button secondary"
          id="liveDemoCancel">
          Close
        </button>
      </div>

    </div>
  </div>
</div>


<script id="live-demo-final-js">

(function(){

  const API =
    window.API_BASE ||
    "http://127.0.0.1:8000";

  const modal =
    document.getElementById("liveDemoModal");

  const stage =
    document.getElementById("liveDemoStage");

  const closeBtn =
    document.getElementById("liveDemoClose");

  const cancelBtn =
    document.getElementById("liveDemoCancel");

  const progress =
    Array.from(
      document.querySelectorAll(
        "#liveDemoModal .live-demo-progress span"
      )
    );

  let running = false;
  let timers = [];

  function wait(ms){
    return new Promise(resolve => {
      const t = setTimeout(resolve, ms);
      timers.push(t);
    });
  }

  function clearTimers(){
    timers.forEach(clearTimeout);
    timers = [];
  }

  function openModal(){
    clearTimers();
    running = true;
    modal.classList.add("open");

    progress.forEach(x =>
      x.classList.remove("active")
    );

    runDemo();
  }

  function closeModal(){
    running = false;
    clearTimers();
    modal.classList.remove("open");
  }

  closeBtn.addEventListener("click", closeModal);
  cancelBtn.addEventListener("click", closeModal);

  modal.addEventListener("click", function(e){
    if(e.target === modal){
      closeModal();
    }
  });

  /*
   * ----------------------------------------------------------
   * API REQUEST
   * ----------------------------------------------------------
   */

  async function api(path, options = {}){

    const controller =
      new AbortController();

    const timeout =
      setTimeout(
        () => controller.abort(),
        8000
      );

    try{

      const response =
        await fetch(
          API + path,
          {
            ...options,
            signal: controller.signal
          }
        );

      if(!response.ok){
        throw new Error(
          path + " returned HTTP " +
          response.status
        );
      }

      return await response.json();

    }finally{

      clearTimeout(timeout);

    }
  }

  /*
   * ----------------------------------------------------------
   * TRANSACTION
   * This matches the CURRENT FastAPI schema shown in Swagger.
   * ----------------------------------------------------------
   */

  function baseTransaction(){

    return {

      amount: 1200,

      merchant_category:
        "grocery",

      merchant_risk_score:
        0.05,

      device_type:
        "mobile_app",

      payment_method:
        "chip",

      geo_distance_km:
        3,

      account_age_days:
        900,

      failed_txn_count_recent:
        0,

      seconds_since_prev_txn:
        3600,

      txn_count_last_1h:
        0,

      txn_count_last_24h:
        1,

      amount_avg_last_5:
        1100,

      amount_deviation_ratio:
        1.09,

      is_new_device_hint:
        0,

      hour_of_day:
        14,

      day_of_week:
        2,

      is_weekend:
        0
    };

  }

  /*
   * ----------------------------------------------------------
   * RENDER HELPERS
   * ----------------------------------------------------------
   */

  function step(n){

    progress.forEach(
      (x,i) =>
        x.classList.toggle(
          "active",
          i < n
        )
    );

  }

  function riskColor(score){

    if(score >= 80)
      return "#ff5366";

    if(score >= 60)
      return "#ffb84d";

    return "#18c79d";

  }

  async function animateRisk(score){

    const number =
      document.getElementById(
        "liveRiskNumber"
      );

    const fill =
      document.getElementById(
        "liveRiskFill"
      );

    if(!number || !fill)
      return;

    let current = 0;

    const target =
      Math.max(
        0,
        Math.min(
          100,
          Number(score) || 0
        )
      );

    fill.style.background =
      riskColor(target);

    while(
      current < target &&
      running
    ){

      current += Math.max(
        .7,
        target / 35
      );

      if(current > target)
        current = target;

      number.textContent =
        current.toFixed(1);

      fill.style.width =
        current + "%";

      await wait(35);

    }

  }

  /*
   * ----------------------------------------------------------
   * FULL LIVE DEMO
   * ----------------------------------------------------------
   */

  async function runDemo(){

    try{

      /*
       * STEP 1
       * Backend health
       */

      step(1);

      stage.innerHTML = `
        <div class="live-demo-kicker">
          STEP 01 · SYSTEM CHECK
        </div>

        <div class="live-demo-headline white">
          Connecting to the<br>
          <span style="color:#18c79d">
            Blue Team
          </span>
        </div>

        <div class="live-demo-sub">
          The browser is making a real request to
          <b>${API}/health</b>.
        </div>

        <div class="live-api-flow">
          <div class="live-api-node">
            Browser
          </div>

          <div class="live-api-arrow">
            →
          </div>

          <div class="live-api-node">
            FastAPI
          </div>

          <div class="live-api-arrow">
            →
          </div>

          <div class="live-api-node">
            XGBoost
          </div>
        </div>
      `;

      const health =
        await api("/health");

      if(!running)
        return;

      await wait(700);

      /*
       * STEP 2
       * Generate
       */

      step(2);

      stage.innerHTML = `
        <div class="live-demo-kicker">
          STEP 02 · GENERATE
        </div>

        <div class="live-demo-headline teal">
          Legitimate transaction
        </div>

        <div class="live-demo-sub">
          Starting with a clean synthetic payment
          before the Red-Team modifies it.
        </div>

        <div class="live-txn-card">

          <div class="live-txn-cell">
            <small>Amount</small>
            <strong>₹1,200</strong>
          </div>

          <div class="live-txn-cell">
            <small>Merchant</small>
            <strong>Grocery</strong>
          </div>

          <div class="live-txn-cell">
            <small>Device</small>
            <strong>Mobile App</strong>
          </div>

          <div class="live-txn-cell">
            <small>Location</small>
            <strong>3 km</strong>
          </div>

        </div>

        <div class="live-result">
          ✓ Synthetic transaction generated
        </div>
      `;

      await wait(1500);

      /*
       * STEP 3
       * Red Team
       */

      step(3);

      stage.innerHTML = `
        <div class="live-demo-kicker">
          STEP 03 · RED TEAM
        </div>

        <div class="live-demo-headline red">
          Behavioral Mimicry Attack
        </div>

        <div class="live-demo-sub">
          The Red-Team simulator crafts a subtle
          adversarial payment designed to look
          like normal customer behaviour.
        </div>

        <div class="live-api-flow">

          <div class="live-api-node">
            ₹1,200
          </div>

          <div class="live-api-arrow">
            →
          </div>

          <div class="live-api-node">
            Red-Team
          </div>

          <div class="live-api-arrow">
            →
          </div>

          <div class="live-api-node">
            /simulate-attack
          </div>

        </div>
      `;

      /*
       * ACTUAL BACKEND CALL
       */

      const attackPayload = {

        transaction:
          baseTransaction(),

        attack_type:
          "behavioral_mimicry"

      };

      const attack =
        await api(
          "/simulate-attack",
          {
            method: "POST",
            headers: {
              "Content-Type":
                "application/json"
            },
            body:
              JSON.stringify(
                attackPayload
              )
          }
        );

      if(!running)
        return;

      const modified =
        attack.modified_transaction ||
        attack.attacked_transaction ||
        {};

      await wait(900);

      /*
       * STEP 4
       * Blue Team
       */

      step(4);

      stage.innerHTML = `
        <div class="live-demo-kicker">
          STEP 04 · BLUE TEAM · LIVE API
        </div>

        <div class="live-demo-headline white">
          Detector is scoring
          the attack
        </div>

        <div class="live-demo-sub">
          Actual response received from
          <b>POST /simulate-attack</b>.
          Now showing the model's risk score.
        </div>

        <div class="live-risk">

          <div
            id="liveRiskNumber"
            class="live-risk-number">
            0.0
          </div>

          <div class="live-risk-label">
            Risk score / 100
          </div>

          <div class="live-risk-track">
            <div
              id="liveRiskFill"
              class="live-risk-fill">
            </div>
          </div>

        </div>

        <div class="live-txn-card">

          <div class="live-txn-cell">
            <small>Attack</small>
            <strong>
              ${attack.attack_type || "behavioral_mimicry"}
            </strong>
          </div>

          <div class="live-txn-cell">
            <small>Modified Amount</small>
            <strong>
              ₹${Math.round(
                Number(
                  modified.amount || 1200
                )
              )}
            </strong>
          </div>

          <div class="live-txn-cell">
            <small>Backend</small>
            <strong>ONLINE</strong>
          </div>

          <div class="live-txn-cell">
            <small>Model</small>
            <strong>XGBoost</strong>
          </div>

        </div>
      `;

      const detector =
        attack.detector_result ||
        {};

      const score =
        Number(
          detector.risk_score ||
          attack.risk_score ||
          attack.fraud_probability * 100 ||
          0
        );

      await animateRisk(score);

      await wait(1200);

      /*
       * STEP 5
       * Result + Metrics
       */

      step(5);

      stage.innerHTML = `
        <div class="live-demo-kicker">
          STEP 05 · DEFENSE RESULT
        </div>

        <div class="live-demo-headline ${
          score >= 50
            ? "teal"
            : "red"
        }">

          ${
            score >= 50
              ? "⚠ ATTACK DETECTED"
              : "✓ ATTACK PASSED DETECTOR"
          }

        </div>

        <div class="live-demo-sub">
          The Blue-Team detector returned
          a risk score of
          <b>${score.toFixed(1)}/100</b>.
        </div>

        <div class="live-result">

          <div class="live-result-big">
            ${detector.prediction ||
              attack.prediction ||
              "Detector response received"}
          </div>

          <div style="margin-top:10px;color:#9ba7bd">
            ${
              detector.narrative ||
              attack.narrative ||
              "Live API analysis completed."
            }
          </div>

        </div>
      `;

      await wait(1300);

      /*
       * STEP 6
       * Metrics / closed-loop evidence
       *
       * IMPORTANT:
       * This reads the real metrics endpoint.
       * It does NOT falsely claim that the browser
       * retrained the model.
       */

      step(6);

      let metrics = null;

      try{
        metrics =
          await api("/metrics");
      }catch(e){
        metrics = null;
      }

      const before =
        metrics?.closed_loop_summary?.detection_rate_before ??
        0.1473333333;

      const after =
        metrics?.closed_loop_summary?.detection_rate_after ??
        0.7963333333;

      const beforePct =
        (Number(before) * 100);

      const afterPct =
        (Number(after) * 100);

      stage.innerHTML = `
        <div class="live-demo-kicker">
          STEP 06 · CLOSED LOOP EVIDENCE
        </div>

        <div class="live-demo-headline teal">
          Detect → Learn → Improve
        </div>

        <div class="live-demo-sub">
          The dashboard now reads the project's
          recorded closed-loop evaluation metrics
          from the backend.
        </div>

        <div class="live-bars">

          <div class="live-bar-row">
            <span>Before</span>

            <div class="live-bar-track">
              <div
                id="liveBeforeBar"
                class="live-bar-fill live-bar-before">
              </div>
            </div>

            <strong>
              ${beforePct.toFixed(1)}%
            </strong>
          </div>

          <div class="live-bar-row">
            <span>After</span>

            <div class="live-bar-track">
              <div
                id="liveAfterBar"
                class="live-bar-fill live-bar-after">
              </div>
            </div>

            <strong>
              ${afterPct.toFixed(1)}%
            </strong>
          </div>

        </div>

        <div class="live-result">

          <div class="live-result-big">
            +${(
              ((afterPct - beforePct) /
                beforePct) * 100
            ).toFixed(0)}%
            relative detection improvement
          </div>

          <div style="
            margin-top:10px;
            color:#9ba7bd;
          ">
            Missed adversarial samples are used
            by the project's offline adversarial
            training pipeline.
          </div>

        </div>

        <div style="
          margin-top:18px;
          color:#7ee7cf;
          font-size:13px;
        ">
          ✓ Live API request completed<br>
          ✓ Red-Team simulation completed<br>
          ✓ Blue-Team scoring completed<br>
          ✓ Closed-loop metrics loaded
        </div>

        <div class="live-demo-footer">

          <button
            class="live-demo-button primary"
            id="liveExploreBtn">
            Explore Dashboard →
          </button>

        </div>
      `;

      await wait(150);

      const bb =
        document.getElementById(
          "liveBeforeBar"
        );

      const ba =
        document.getElementById(
          "liveAfterBar"
        );

      if(bb)
        bb.style.width =
          Math.min(beforePct,100) + "%";

      if(ba)
        ba.style.width =
          Math.min(afterPct,100) + "%";

      const explore =
        document.getElementById(
          "liveExploreBtn"
        );

      if(explore){

        explore.addEventListener(
          "click",
          () => {

            closeModal();

            const target =
              document.getElementById(
                "fraud"
              ) ||
              document.getElementById(
                "demo"
              );

            if(target){

              target.scrollIntoView({
                behavior: "smooth"
              });

            }

          }
        );

      }

    }catch(error){

      if(!running)
        return;

      stage.innerHTML = `
        <div class="live-demo-kicker">
          LIVE API ERROR
        </div>

        <div class="live-demo-headline red">
          Backend request failed
        </div>

        <div class="live-error">

          ${String(error.message || error)}

          <br><br>

          Check that FastAPI is running on:

          <b>${API}</b>

          <br><br>

          Expected endpoints:

          <br>
          GET /health
          <br>
          POST /predict
          <br>
          POST /simulate-attack
          <br>
          GET /metrics

        </div>
      `;

    }

  }

  /*
   * ----------------------------------------------------------
   * CONNECT HERO BUTTON
   * ----------------------------------------------------------
   */

  window.runFullDemo =
    openModal;

  /*
   * ----------------------------------------------------------
   * CIRCLE CLICK ACTIONS
   * ----------------------------------------------------------
   */

  const red =
    document.querySelector(
      ".vcircle.red"
    );

  const blue =
    document.querySelector(
      ".vcircle.teal"
    );

  const loop =
    document.querySelector(
      ".vlabel.loop"
    );

  function go(id){

    const el =
      document.getElementById(id);

    if(el){

      el.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

      el.style.outline =
        "3px solid rgba(24,199,157,.45)";

      setTimeout(
        () => {
          el.style.outline = "";
        },
        1200
      );

    }

  }

  if(red){

    red.title =
      "Open Red-Team Attack Simulator";

    red.addEventListener(
      "click",
      () => {

        go("attack");

      }
    );

  }

  if(blue){

    blue.title =
      "Open Blue-Team Fraud Detection";

    blue.addEventListener(
      "click",
      () => {

        go("fraud");

      }
    );

  }

  if(loop){

    loop.title =
      "Run the complete closed-loop demo";

    loop.addEventListener(
      "click",
      openModal
    );

  }

  /*
   * ----------------------------------------------------------
   * ALSO MAKE LABELS CLICKABLE
   * ----------------------------------------------------------
   */

  document
    .querySelectorAll(
      ".vlabel.red"
    )
    .forEach(el => {

      el.style.cursor =
        "pointer";

      el.addEventListener(
        "click",
        () => go("attack")
      );

    });

  document
    .querySelectorAll(
      ".vlabel.teal"
    )
    .forEach(el => {

      el.style.cursor =
        "pointer";

      el.addEventListener(
        "click",
        () => go("fraud")
      );

    });

  /*
   * ----------------------------------------------------------
   * AUTO HEALTH CHECK
   * ----------------------------------------------------------
   */

  async function healthCheck(){

    try{

      const h =
        await api("/health");

      document
        .querySelectorAll(
          "#statusText"
        )
        .forEach(el => {

          el.textContent =
            h.status === "ok"
              ? "API online · XGBoost ready"
              : "API error";

        });

      document
        .querySelectorAll(
          "#healthModel"
        )
        .forEach(el => {

          el.textContent =
            h.model_loaded
              ? "READY"
              : "OFFLINE";

        });

    }catch(e){

      document
        .querySelectorAll(
          "#statusText"
        )
        .forEach(el => {

          el.textContent =
            "API offline";

        });

    }

  }

  healthCheck();

})();

</script>

</body>

</html>
