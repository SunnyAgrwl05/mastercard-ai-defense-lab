            <div class="result" id="scoreResult">
              <div class="hint">
                Enter transaction data and run the detector to receive fraud probability, risk score and explanation.
              </div>
            </div>

          </div>

          <div class="team-card red-team" id="attack">

            <div class="team-header">
              <div class="team-title">
                <span class="team-badge red">
                  RED TEAM
                </span>

                <h3>
                  Attack Simulator
                </h3>
              </div>

              <div class="live-label">
                POST /simulate-attack
              </div>
            </div>

            <label>
              Attack Family
